config BR2_PACKAGE_MORSE_TOOLS
	bool "Morse Micro S1G hostap/wpa_supplicant"
	depends on BR2_USE_MMU # fork()
	depends on BR2_TOOLCHAIN_HAS_THREADS # libnl
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 # morse-cli -> libusb
	select BR2_PACKAGE_LIBNL
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_OPENSSL_FORCE_LIBOPENSSL
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_DES
	select BR2_PACKAGE_LIBOPENSSL_ENABLE_MD4
	select BR2_PACKAGE_MORSE_CLI
	help
	  Morse Micro's 802.11ah/S1G hostap tree.

	  This package installs S1G-specific binaries with separate names:
	  wpa_supplicant_s1g, wpa_cli_s1g, wpa_passphrase_s1g,
	  hostapd_s1g and hostapd_cli_s1g.

	  It does not replace Buildroot's standard wpa_supplicant or
	  hostapd packages.

comment "Morse Micro S1G hostap/wpa_supplicant needs a toolchain w/ threads"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS

comment "Morse Micro S1G hostap/wpa_supplicant needs a toolchain w/ gcc >= 4.9"
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_TOOLCHAIN_GCC_AT_LEAST_4_9

comment "Morse Micro S1G hostap/wpa_supplicant needs MMU"
	depends on !BR2_USE_MMU
