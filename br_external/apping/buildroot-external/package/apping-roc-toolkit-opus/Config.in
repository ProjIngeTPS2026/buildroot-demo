config BR2_PACKAGE_APPING_ROC_TOOLKIT_OPUS
	bool "apping-roc-toolkit-opus"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBSNDFILE
	select BR2_PACKAGE_LIBUV
	select BR2_PACKAGE_OPUS
	select BR2_PACKAGE_PULSEAUDIO
	select BR2_PACKAGE_SPEEXDSP
	help
	  Local Roc Toolkit build modified for Apping live audio.
	  Installs roc-send and roc-recv with Opus support.

comment "apping-roc-toolkit-opus needs a C++ toolchain with NPTL, wchar and shared libraries"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS_NPTL || !BR2_USE_WCHAR || BR2_STATIC_LIBS
